<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
<title>Route Explorer | Solving the Traveling Salesman Problem</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style>
/* ── RESET & BASE (Dark Rose / Plum Research Lab) ─────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{background:#130B14;color:#F6F1F4;font-family:'Inter',sans-serif;line-height:1.7;min-height:100vh;overflow-x:hidden}
button{cursor:pointer;font-family:inherit}
a{color:inherit;text-decoration:none}

:root{
  --bg:#130B14;
  --section-bg:#1E1321;
  --card-bg:#27182D;
  --accent:#D94F8A;
  --accent2:#F07DB1;
  --highlight:#FFB3D1;
  --text:#F6F1F4;
  --muted:#BCAEB8;
  --border:rgba(217,79,138,0.18);
  --glow:rgba(217,79,138,0.12);
  --radius:12px;
  --radius-lg:20px;
  --transition:0.3s cubic-bezier(.4,0,.2,1);
}

::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--accent);border-radius:3px}

h1,h2,h3,h4,h5{font-family:'Space Grotesk',sans-serif;letter-spacing:-0.02em;line-height:1.2}
h1{font-size:clamp(2.4rem,6vw,4.8rem);font-weight:700}
h2{font-size:clamp(1.6rem,3.5vw,2.8rem);font-weight:600}
h3{font-size:clamp(1.1rem,2vw,1.5rem);font-weight:600}
p{color:var(--muted);font-size:0.97rem;line-height:1.8}
.accent{color:var(--accent)}
.accent2{color:var(--accent2)}
.highlight{color:var(--highlight)}
.container{max-width:1200px;margin:0 auto;padding:0 2rem}
.section-label{display:inline-flex;align-items:center;gap:0.5rem;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.14em;color:var(--accent);margin-bottom:1rem}
.section-label::before{content:'';display:inline-block;width:20px;height:2px;background:var(--accent)}
.divider{width:60px;height:3px;background:linear-gradient(90deg,var(--accent),transparent);border-radius:2px;margin:1.5rem 0}

nav{position:sticky;top:0;width:100%;z-index:100;padding:1rem 0;background:rgba(19,11,20,0.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto;padding:0 2rem}
.nav-logo{font-family:'Space Grotesk',sans-serif;font-size:0.85rem;font-weight:700;letter-spacing:0.06em;color:var(--text)}
.nav-logo span{color:var(--accent)}
.nav-links{display:flex;gap:0.25rem;list-style:none}
.nav-links a{padding:0.4rem 0.9rem;border-radius:50px;font-size:0.8rem;font-weight:500;color:var(--muted);transition:color var(--transition),background var(--transition)}
.nav-links a:hover{color:var(--text);background:rgba(217,79,138,0.1)}

/* Hero */
#hero{position:relative;min-height:55vh;display:flex;align-items:center;background:var(--section-bg);border-radius:0 0 2rem 2rem;overflow:hidden}
.hero-bg-num{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Space Grotesk',sans-serif;font-size:clamp(12rem,28vw,22rem);font-weight:700;color:rgba(217,79,138,0.05);user-select:none;pointer-events:none}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;position:relative;z-index:1}
.hero-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.8rem}

/* sections */
section{padding:5rem 0;position:relative}
section:nth-child(even){background:var(--section-bg)}
.section-header{margin-bottom:3rem}
.section-num{font-family:'Space Grotesk',sans-serif;font-size:clamp(5rem,12vw,9rem);font-weight:700;color:rgba(217,79,138,0.06);line-height:1;position:absolute;top:-1rem;right:2rem;user-select:none;pointer-events:none}

.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
.card-bg{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.8rem;transition:all var(--transition)}
.card-bg:hover{transform:translateY(-4px);border-color:var(--accent);box-shadow:0 12px 30px var(--glow)}

/* Demo: Network Graph */
.demo-container{background:var(--card-bg);border-radius:var(--radius-lg);padding:1.5rem;border:1px solid var(--border)}
.graph-svg{width:100%;background:#0B070C;border-radius:var(--radius);margin-bottom:1rem}
.route-builder{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:1rem}
.route-panel{flex:1;background:rgba(0,0,0,0.3);border-radius:var(--radius);padding:1rem}
.scenario-buttons{display:flex;gap:0.8rem;margin:1rem 0}
.btn-scenario{padding:0.5rem 1rem;background:transparent;border:1px solid var(--border);border-radius:50px;font-size:0.75rem;font-weight:600;color:var(--muted);transition:all var(--transition)}
.btn-scenario.active{background:var(--accent);color:#130B14;border-color:var(--highlight)}
.btn-primary{padding:0.6rem 1.2rem;background:linear-gradient(135deg,var(--accent),#B03472);border:none;border-radius:50px;font-weight:600;color:#fff}
.btn-outline{padding:0.6rem 1.2rem;background:transparent;border:1px solid var(--accent);border-radius:50px;color:var(--accent2)}
.route-list{list-style:none;margin-top:0.5rem}
.route-list li{padding:0.3rem 0;border-bottom:1px solid var(--border);font-size:0.85rem}

/* Evidence */
.evidence-archive{display:flex;flex-direction:column;gap:2rem}
.evidence-item{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.6rem;transition:border-color var(--transition)}
.evidence-item:hover{border-color:var(--accent)}
.styled-table{width:100%;border-collapse:collapse;margin-top:0.5rem}
.styled-table th,.styled-table td{padding:0.6rem;border-bottom:1px solid var(--border);text-align:center}
.styled-table th{color:var(--accent)}
.network-svg{background:#0B070C;border-radius:var(--radius);padding:1rem;width:100%}
.comparison-card{background:#130B14;border-radius:var(--radius);padding:1rem;margin-top:0.5rem}
.note-card{background:rgba(217,79,138,0.08);border-left:3px solid var(--accent);padding:1rem;margin-top:1rem;border-radius:var(--radius)}

.learning-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.learning-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.8rem;transition:all var(--transition)}
.learning-card:hover{transform:translateY(-5px);box-shadow:0 18px 40px var(--glow)}
.learning-icon{width:48px;height:48px;border-radius:var(--radius);background:rgba(217,79,138,0.1);display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:1.2rem}
.learn-item{display:flex;align-items:flex-start;gap:0.6rem;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.85rem;color:var(--muted)}
.learn-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);margin-top:0.5rem}
footer{padding:2rem 0;border-top:1px solid var(--border);text-align:center}
@media (max-width: 800px){
  .grid-2,.learning-grid,.hero-grid{grid-template-columns:1fr}
  .container{padding:0 1.2rem}
  section{padding:3rem 0}
}
</style>
</head>
<body>
<nav>
  <div class="nav-inner">
    <div class="nav-logo">TSp<span>·</span>MS</div>
    <ul class="nav-links">
      <li><a href="#overview">01 Overview</a></li>
      <li><a href="#demo">02 Demonstration</a></li>
      <li><a href="#evidence">03 Evidence</a></li>
      <li><a href="#learn">04 Learning</a></li>
    </ul>
  </div>
</nav>

<section id="hero">
  <div class="hero-bg-num">05</div>
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="section-label">Chapter 6 · TSP</div>
        <h1 class="hero-title">Route Explorer:<br><span class="line2">Solving the Traveling Salesman Problem</span></h1>
        <p>Interactive network optimization — build routes, calculate distances, and explore how removing roads changes optimal logistics.</p>
      </div>
      <div class="hero-card">
        <h3>🚚 The Challenge</h3>
        <p>Start at Warehouse (WH), visit all towns (A, B, C, D) exactly once, return to WH. Minimize total distance.</p>
        <div class="divider" style="margin:1rem 0"></div>
        <p><strong class="highlight">5 nodes · 10 edges · 24 possible routes</strong></p>
      </div>
    </div>
  </div>
</section>

<!-- 01 Project Overview -->
<section id="overview">
  <div class="container" style="position:relative">
    <div class="section-num">01</div>
    <div class="section-header">
      <div class="section-label">Project Overview</div>
      <h2>Traveling Salesman Problem</h2>
      <div class="divider"></div>
    </div>
    <div class="grid-2">
      <div class="card-bg">
        <h3>📍 Problem Definition</h3>
        <p>The Traveling Salesman Problem (TSP) asks: given a set of cities and distances between them, what is the shortest possible route that visits each city exactly once and returns to the origin? This is a cornerstone of operations research and logistics optimization.</p>
        <p class="mt-2" style="margin-top:1rem">Our network: Warehouse (WH) + Towns A, B, C, D. Each edge has a distance. The goal: find minimum Hamiltonian cycle.</p>
      </div>
      <div class="card-bg">
        <h3>📐 Why It Matters</h3>
        <p>TSP appears in delivery routing, last-mile logistics, manufacturing, and DNA sequencing. As cities increase, brute-force becomes impossible (n! complexity). This activity demonstrates systematic exploration and the impact of connectivity changes.</p>
      </div>
    </div>
  </div>
</section>

<!-- 02 Demonstration: Interactive TSP Explorer -->
<section id="demo">
  <div class="container" style="position:relative">
    <div class="section-num">02</div>
    <div class="section-header">
      <div class="section-label">Interactive Lab</div>
      <h2>Route Builder</h2>
      <div class="divider"></div>
      <p>Click towns in sequence to build a route. Start and end at Warehouse (WH).</p>
    </div>
    <div class="demo-container">
      <svg id="networkSvg" class="graph-svg" viewBox="0 0 800 450" style="background:#0B070C; border-radius:12px"></svg>
      <div class="route-builder">
        <div class="route-panel">
          <h3>📝 Your Route</h3>
          <div id="routeDisplay" style="font-family:monospace; background:#130B14; padding:0.5rem; border-radius:8px; margin:0.5rem 0">WH → </div>
          <div>📏 Distance: <strong id="routeDistance" class="highlight">0</strong> units</div>
          <div style="margin-top:0.8rem">
            <button id="clearRouteBtn" class="btn-outline">Clear Route</button>
            <button id="compareBtn" class="btn-primary" style="margin-left:0.5rem">Compare to Best</button>
          </div>
          <div id="comparisonMsg" class="note-card" style="margin-top:1rem; font-size:0.8rem">Click "Compare to Best" to see how your route performs.</div>
        </div>
        <div class="route-panel">
          <h3>⚙️ Challenge Mode</h3>
          <div class="scenario-buttons">
            <button id="scenAll" class="btn-scenario active">Scenario 1: All roads</button>
            <button id="scenRemoved" class="btn-scenario">Scenario 2: C↔D removed</button>
          </div>
          <div id="scenarioInfo" style="background:#130B14; border-radius:8px; padding:0.6rem; font-size:0.8rem">✅ All connections available. Best known route distance: 25</div>
          <div class="note-card" style="margin-top:0.8rem; font-size:0.7rem">💡 Tip: Click nodes in order (WH → A → B → C → D → WH). The route must start/end at WH.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 03 Evidence -->
<section id="evidence">
  <div class="container" style="position:relative">
    <div class="section-num">03</div>
    <div class="section-header">
      <div class="section-label">Evidence Archive</div>
      <h2>Classroom TSP Activity</h2>
      <div class="divider"></div>
    </div>
    <div class="evidence-archive">
      <!-- Evidence 1: Distance Matrix -->
      <div class="evidence-item">
        <h3>📊 Evidence Item 1 — Original Distance Matrix</h3>
        <table class="styled-table">
          <thead><tr><th>From / To</th><th>WH</th><th>A</th><th>B</th><th>C</th><th>D</th></tr></thead>
          <tbody>
            <tr><td>WH</td><td>—</td><td>6</td><td>8</td><td>7</td><td>10</td></tr>
            <tr><td>A</td><td>6</td><td>—</td><td>4</td><td>3</td><td>7</td></tr>
            <tr><td>B</td><td>8</td><td>4</td><td>—</td><td>5</td><td>6</td></tr>
            <tr><td>C</td><td>7</td><td>3</td><td>5</td><td>—</td><td>2</td></tr>
            <tr><td>D</td><td>10</td><td>7</td><td>6</td><td>2</td><td>—</td></tr>
          </tbody>
        </table>
        <p class="insight" style="margin-top:0.8rem; font-size:0.75rem">📌 The network distances were provided as part of a classroom TSP activity. Note symmetry: distances are undirected.</p>
      </div>

      <!-- Evidence 2: Network Visualization -->
      <div class="evidence-item">
        <h3>🗺️ Evidence Item 2 — Network Visualization</h3>
        <svg id="staticNetwork" class="network-svg" viewBox="0 0 800 300" style="background:#0B070C; margin-bottom:0.5rem"></svg>
        <p style="font-size:0.75rem; color:var(--muted)">Operations research network diagram showing all nodes (WH, A, B, C, D) and weighted edges. Distances labeled in woowoo-units.</p>
      </div>

      <!-- Evidence 3: Route Investigation Table -->
      <div class="evidence-item">
        <h3>🔍 Evidence Item 3 — Route Investigation Table</h3>
        <table class="styled-table">
          <thead><tr><th>Route</th><th>Distance</th></tr></thead>
          <tbody>
            <tr><td>WH → A → B → C → D → WH</td><td>6+4+5+2+10 = 27</td></tr>
            <tr><td>WH → A → C → D → B → WH</td><td>6+3+2+6+8 = 25</td></tr>
            <tr><td>WH → B → D → C → A → WH</td><td>8+6+2+3+6 = 25</td></tr>
            <tr><td>WH → C → A → B → D → WH</td><td>7+3+4+6+10 = 30</td></tr>
          </tbody>
        </table>
        <div class="note-card" style="margin-top:0.8rem">📝 The activity emphasized exploring multiple possibilities rather than immediately finding a single answer. Two distinct routes achieve 25 units.</div>
      </div>

      <!-- Evidence 4: Constraint Scenario Analysis -->
      <div class="evidence-item">
        <h3>⚠️ Evidence Item 4 — Constraint Scenario Analysis</h3>
        <div class="comparison-card">
          <h4>Scenario 1: All roads available</h4>
          <p>Lowest known route distance: <strong class="highlight">25</strong> (WH→A→C→D→B→WH or WH→B→D→C→A→WH)</p>
          <div class="divider" style="margin:0.5rem 0"></div>
          <h4>Scenario 2: Road C ↔ D removed</h4>
          <p>Lowest known route distance: <strong class="accent2">30</strong> (e.g., WH→A→B→C→A? Not allowed; alternative path required)</p>
          <p style="margin-top:0.5rem; font-size:0.8rem">🔹 Removing connection C–D increases the shortest route from 25 to 30. The network becomes less flexible, forcing detours and raising transportation cost by 20%.</p>
        </div>
      </div>

      <!-- Evidence 5: Questions and Observations -->
      <div class="evidence-item">
        <h3>📖 Evidence Item 5 — Investigation Reflections</h3>
        <div class="note-card">
          <ul style="margin-left:1.2rem; color:var(--muted); font-size:0.85rem">
            <li><strong>What is the lowest cost route?</strong> 25 units (WH→A→C→D→B→WH or reverse).</li>
            <li><strong>Are multiple optimal routes possible?</strong> Yes, two distinct optimal routes exist due to symmetry.</li>
            <li><strong>How can all optimal routes be identified?</strong> Exhaustive enumeration (4! = 24 permutations) or systematic branch-and-bound.</li>
            <li><strong>Can a decision tree help explore route combinations?</strong> Absolutely. A decision tree visualizes the sequential choices of next town, pruning dominated branches.</li>
          </ul>
        </div>
        <p style="margin-top:0.6rem; font-size:0.75rem">These questions were part of the investigation process, encouraging structured exploration before optimization.</p>
      </div>
    </div>
  </div>
</section>

<!-- 04 What Did I Learn? -->
<section id="learn">
  <div class="container" style="position:relative">
    <div class="section-num">04</div>
    <div class="section-header">
      <div class="section-label">Reflections</div>
      <h2>What Did I Learn?</h2>
      <div class="divider"></div>
    </div>
    <div class="learning-grid">
      <div class="learning-card"><div class="learning-icon">📘</div><h3>Knowledge</h3><div class="learn-item"><span class="learn-dot"></span>Networks & Graph Theory</div><div class="learn-item"><span class="learn-dot"></span>Traveling Salesman Problem (TSP)</div><div class="learn-item"><span class="learn-dot"></span>Route optimization fundamentals</div><div class="learn-item"><span class="learn-dot"></span>Transportation & logistics modeling</div><div class="learn-item"><span class="learn-dot"></span>Hamiltonian cycles</div></div>
      <div class="learning-card"><div class="learning-icon">⚙️</div><h3>Skills</h3><div class="learn-item"><span class="learn-dot"></span>Graph interpretation & visualization</div><div class="learn-item"><span class="learn-dot"></span>Systematic route comparison</div><div class="learn-item"><span class="learn-dot"></span>Constraint impact analysis</div><div class="learn-item"><span class="learn-dot"></span>Sequential decision making</div><div class="learn-item"><span class="learn-dot"></span>Brute-force reasoning for small n</div></div>
      <div class="learning-card"><div class="learning-icon">💡</div><h3>Reflection</h3><div class="learn-item"><span class="learn-dot"></span>The shortest-looking route is not always optimal</div><div class="learn-item"><span class="learn-dot"></span>Small network changes can dramatically affect outcomes</div><div class="learn-item"><span class="learn-dot"></span>Transportation decisions become difficult as locations increase</div><div class="learn-item"><span class="learn-dot"></span>Exhaustive search quickly becomes impractical, motivating advanced methods (heuristics, dynamic programming)</div></div>
    </div>
  </div>
</section>
<footer><div class="container"><div class="nav-logo" style="margin-bottom:0.5rem">MGMT<span>·</span>SCI</div><p>Route Explorer — Traveling Salesman Problem | Management Science Portfolio</p></div></footer>

<script>
  // Node coordinates (positions for visualization)
  const nodes = [
    { id: "WH", x: 150, y: 200 },
    { id: "A", x: 320, y: 100 },
    { id: "B", x: 500, y: 80 },
    { id: "C", x: 620, y: 200 },
    { id: "D", x: 500, y: 340 }
  ];
  const fullEdges = [
    { from: "WH", to: "A", dist: 6 }, { from: "WH", to: "B", dist: 8 }, { from: "WH", to: "C", dist: 7 }, { from: "WH", to: "D", dist: 10 },
    { from: "A", to: "B", dist: 4 }, { from: "A", to: "C", dist: 3 }, { from: "A", to: "D", dist: 7 },
    { from: "B", to: "C", dist: 5 }, { from: "B", to: "D", dist: 6 },
    { from: "C", to: "D", dist: 2 }
  ];
  
  let removedEdge = false; // false = all roads, true = C-D removed
  let currentRoute = ["WH"];
  let svg, staticSvg;
  
  function getCurrentEdges() {
    if (!removedEdge) return fullEdges;
    return fullEdges.filter(e => !(e.from === "C" && e.to === "D") && !(e.from === "D" && e.to === "C"));
  }
  
  function getDistance(nodeA, nodeB) {
    const edge = getCurrentEdges().find(e => (e.from === nodeA && e.to === nodeB) || (e.from === nodeB && e.to === nodeA));
    return edge ? edge.dist : null;
  }
  
  function computeRouteDistance(route) {
    if (route.length < 2) return 0;
    let total = 0;
    for (let i = 0; i < route.length - 1; i++) {
      const d = getDistance(route[i], route[i+1]);
      if (d === null) return Infinity;
      total += d;
    }
    return total;
  }
  
  function getBestDistance() {
    if (!removedEdge) return 25;
    else return 30; // known from scenario analysis
  }
  
  function drawGraph() {
    if (!svg) svg = document.getElementById("networkSvg");
    svg.innerHTML = "";
    const edges = getCurrentEdges();
    // draw edges
    edges.forEach(edge => {
      const fromNode = nodes.find(n => n.id === edge.from);
      const toNode = nodes.find(n => n.id === edge.to);
      if (!fromNode || !toNode) return;
      const midX = (fromNode.x + toNode.x)/2;
      const midY = (fromNode.y + toNode.y)/2 - 8;
      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      line.setAttribute("x1", fromNode.x); line.setAttribute("y1", fromNode.y);
      line.setAttribute("x2", toNode.x); line.setAttribute("y2", toNode.y);
      line.setAttribute("stroke", "#D94F8A80"); line.setAttribute("stroke-width", "2");
      svg.appendChild(line);
      const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
      text.setAttribute("x", midX); text.setAttribute("y", midY);
      text.setAttribute("fill", "#F07DB1"); text.setAttribute("font-size", "12");
      text.textContent = edge.dist;
      svg.appendChild(text);
    });
    nodes.forEach(node => {
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("cx", node.x); circle.setAttribute("cy", node.y);
      circle.setAttribute("r", "18");
      circle.setAttribute("fill", "#27182D"); circle.setAttribute("stroke", "#FFB3D1"); circle.setAttribute("stroke-width", "2");
      circle.setAttribute("data-id", node.id);
      circle.style.cursor = "pointer";
      circle.addEventListener("click", () => addToRoute(node.id));
      svg.appendChild(circle);
      const label = document.createElementNS("http://www.w3.org/2000/svg", "text");
      label.setAttribute("x", node.x); label.setAttribute("y", node.y+5);
      label.setAttribute("fill", "#F6F1F4"); label.setAttribute("font-size", "12"); label.setAttribute("text-anchor", "middle");
      label.textContent = node.id;
      svg.appendChild(label);
    });
  }
  
  function drawStaticNetwork() {
    const container = document.getElementById("staticNetwork");
    container.innerHTML = "";
    const edges = fullEdges;
    edges.forEach(edge => {
      const fromNode = nodes.find(n => n.id === edge.from);
      const toNode = nodes.find(n => n.id === edge.to);
      if (!fromNode || !toNode) return;
      const midX = (fromNode.x + toNode.x)/2;
      const midY = (fromNode.y + toNode.y)/2 - 6;
      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      line.setAttribute("x1", fromNode.x); line.setAttribute("y1", fromNode.y);
      line.setAttribute("x2", toNode.x); line.setAttribute("y2", toNode.y);
      line.setAttribute("stroke", "#D94F8A60"); line.setAttribute("stroke-width", "1.5");
      container.appendChild(line);
      const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
      text.setAttribute("x", midX); text.setAttribute("y", midY);
      text.setAttribute("fill", "#F07DB1"); text.setAttribute("font-size", "10");
      text.textContent = edge.dist;
      container.appendChild(text);
    });
    nodes.forEach(node => {
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("cx", node.x); circle.setAttribute("cy", node.y);
      circle.setAttribute("r", "16");
      circle.setAttribute("fill", "#1E1321"); circle.setAttribute("stroke", "#D94F8A"); circle.setAttribute("stroke-width", "1.5");
      container.appendChild(circle);
      const label = document.createElementNS("http://www.w3.org/2000/svg", "text");
      label.setAttribute("x", node.x); label.setAttribute("y", node.y+4);
      label.setAttribute("fill", "#FFB3D1"); label.setAttribute("font-size", "11"); label.setAttribute("text-anchor", "middle");
      label.textContent = node.id;
      container.appendChild(label);
    });
  }
  
  function addToRoute(nodeId) {
    if (currentRoute.length === 0) { currentRoute.push(nodeId); updateRouteDisplay(); return; }
    const last = currentRoute[currentRoute.length-1];
    if (getDistance(last, nodeId) === null) { alert("No direct connection! Choose an adjacent town."); return; }
    if (currentRoute.includes(nodeId) && nodeId !== "WH") { alert("Already visited that town. Must visit each exactly once."); return; }
    if (nodeId === "WH" && currentRoute.length < nodes.length) { alert("You must visit all towns before returning to Warehouse."); return; }
    if (nodeId === "WH" && currentRoute.length === nodes.length) {
      if (getDistance(last, "WH") !== null) { currentRoute.push("WH"); updateRouteDisplay(); }
      else alert("No direct connection back to Warehouse!");
      return;
    }
    if (currentRoute.length < nodes.length) { currentRoute.push(nodeId); updateRouteDisplay(); }
  }
  
  function updateRouteDisplay() {
    const routeStr = currentRoute.join(" → ");
    document.getElementById("routeDisplay").innerHTML = routeStr + (currentRoute.length === nodes.length+1 ? " (complete)" : "");
    const distance = computeRouteDistance(currentRoute);
    document.getElementById("routeDistance").innerHTML = distance === Infinity ? "Invalid" : distance;
  }
  
  function compareRoute() {
    const userDist = computeRouteDistance(currentRoute);
    const best = getBestDistance();
    const msgDiv = document.getElementById("comparisonMsg");
    if (userDist === Infinity || currentRoute.length !== nodes.length+1 || currentRoute[0] !== "WH" || currentRoute[currentRoute.length-1] !== "WH") {
      msgDiv.innerHTML = "⚠️ Complete your route first (start at WH, visit all towns, return to WH).";
      return;
    }
    if (userDist === best) msgDiv.innerHTML = `🎉 Perfect! Your route distance (${userDist}) equals the optimal distance (${best}). Excellent optimization!`;
    else if (userDist < best) msgDiv.innerHTML = `✨ Amazing! Your route (${userDist}) beats the known optimum? Double-check distances.`;
    else msgDiv.innerHTML = `📊 Your route: ${userDist} vs Best: ${best}. Difference: ${userDist-best}. Try different sequences — often the shortest path isn't obvious.`;
  }
  
  function clearRoute() { currentRoute = ["WH"]; updateRouteDisplay(); }
  
  function setScenario(allRoads) {
    removedEdge = !allRoads;
    document.getElementById("scenAll").classList.toggle("active", allRoads);
    document.getElementById("scenRemoved").classList.toggle("active", !allRoads);
    const best = getBestDistance();
    document.getElementById("scenarioInfo").innerHTML = allRoads ? 
      "✅ All connections available. Best known route distance: 25" : 
      "⚠️ Road C↔D removed. Best known route distance: 30. Network is constrained.";
    clearRoute();
    drawGraph();
    updateRouteDisplay();
  }
  
  window.onload = () => {
    svg = document.getElementById("networkSvg");
    drawGraph();
    drawStaticNetwork();
    document.getElementById("clearRouteBtn").addEventListener("click", clearRoute);
    document.getElementById("compareBtn").addEventListener("click", compareRoute);
    document.getElementById("scenAll").addEventListener("click", () => setScenario(true));
    document.getElementById("scenRemoved").addEventListener("click", () => setScenario(false));
    currentRoute = ["WH"]; updateRouteDisplay();
  };
</script>
</body>
</html>
